                      (Top_List_mem1 lc_R c)
                      (not
                        (= (Top_SKE_RND_CCA_CPA_UFCMA_dec gs_R k_R c) 
                        (as Top_Logic_None (Top_Logic_option Top_SKE_RND_plaintext)))))))
                (= (= result_L true) (= result_R true)))))))))))

(check-sat)

