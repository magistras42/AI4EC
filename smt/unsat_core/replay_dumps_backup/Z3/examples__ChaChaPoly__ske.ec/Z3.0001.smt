;; Goal "goal"
(assert
  (not
  (forall ((et2 (tuple2 (tuple6 Top_SKE_RND_plaintext Top_SKE_RND_ciphertext Top_SKE_RND_plaintext Top_SKE_RND_ciphertext Top_SKE_RND_key Top_SKE_RND_plaintext) memory)))
    (=>
      (not
        (exists ((c Top_SKE_RND_ciphertext))
          (and
            (Top_List_mem1 (Top_SKE_RND_Mem_sllc (proj2_1 et2)) c)
            (not
              (= (Top_SKE_RND_CCA_CPA_UFCMA_dec
                   (Top_SKE_RND_CCA_CPA_UFCMA_StLSke_slgs (proj2_1 et2))
                   (Top_SKE_RND_Mem_slk (proj2_1 et2))
                   c) (as Top_Logic_None (Top_Logic_option Top_SKE_RND_plaintext)))))))
      (=>
        (Top_SKE_RND_CCA_CPA_UFCMA_valid_key
          (Top_SKE_RND_Mem_slk (proj2_1 et2)))
        (=>
          (forall ((c Top_SKE_RND_ciphertext))
            (=>
              (Top_FMap_dom1 (Top_SKE_RND_Mem_sllog (proj2_1 et2)) c)
              (= (Top_SKE_RND_CCA_CPA_UFCMA_dec
                   (Top_SKE_RND_CCA_CPA_UFCMA_StLSke_slgs (proj2_1 et2))
                   (Top_SKE_RND_Mem_slk (proj2_1 et2))
                   c) (Top_FMap___lb_rb1
                        (Top_SKE_RND_Mem_sllog (proj2_1 et2))
                        c))))
          (forall ((c1 Top_SKE_RND_ciphertext))
            (=>
              (Top_FMap_dom1
                (Top_FMap___lb_lsmn_rb1
                  (Top_SKE_RND_Mem_sllog (proj2_1 et2))
                  (Top_SKE_RND_CCA_CPA_UFCMA_enc
                    (Top_SKE_RND_CCA_CPA_UFCMA_StLSke_slgs (proj2_1 et2))
                    (Top_SKE_RND_Mem_slk (proj2_1 et2))
                    (proj6_0 (proj2_0 et2)))
                  (proj6_0 (proj2_0 et2)))
                c1)
              (= (Top_SKE_RND_CCA_CPA_UFCMA_dec
                   (Top_SKE_RND_CCA_CPA_UFCMA_StLSke_slgs (proj2_1 et2))
                   (Top_SKE_RND_Mem_slk (proj2_1 et2))
                   c1) (Top_FMap___lb_rb1
                         (Top_FMap___lb_lsmn_rb1
                           (Top_SKE_RND_Mem_sllog (proj2_1 et2))
                           (Top_SKE_RND_CCA_CPA_UFCMA_enc
                             (Top_SKE_RND_CCA_CPA_UFCMA_StLSke_slgs
                               (proj2_1 et2))
                             (Top_SKE_RND_Mem_slk (proj2_1 et2))
                             (proj6_0 (proj2_0 et2)))
                           (proj6_0 (proj2_0 et2)))
                         c1))))))))))

(check-sat)

