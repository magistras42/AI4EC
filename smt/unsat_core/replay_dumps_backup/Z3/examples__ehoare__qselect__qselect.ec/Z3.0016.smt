  uni) uni)

;; "Tuple2_sort"
(assert
  (forall ((a16 ty) (a17 ty))
    (forall ((x uni) (x1 uni))
      (sort (tuple21 a17 a16) (Tuple21 a17 a16 x x1)))))

;; "proj2_0"
