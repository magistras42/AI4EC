    (! (= (tb2t18 (t2tb18 i)) i) :pattern ((t2tb18 i)) )))

;; "BridgeR"
(assert
  (forall ((j uni))
    (! (=> (sort (distr1 Top_Byte_byte1) j) (= (t2tb18 (tb2t18 j)) j)) :pattern (
    (t2tb18
      (tb2t18 j))) )))

;; "h1"
(assert
  (Top_Distr_support
    (Top_List_list1 Top_Byte_byte1)
    (Top_DList_dlist
      Top_Byte_byte1
      (Top_Distr_MUniform_duniform
        Top_Byte_byte1
        (t2tb2 Top_Byte_Support_enum))
      Top_Poly_in_poly_in_size)
    (t2tb2 l1)))

;; "Top_Poly_out_poly_out_size"
(declare-fun Top_Poly_out_poly_out_size () Int)

;; "h2"
(assert
  (Top_Distr_support
    (Top_List_list1 Top_Byte_byte1)
    (Top_DList_dlist
      Top_Byte_byte1
      (Top_Distr_MUniform_duniform
        Top_Byte_byte1
        (t2tb2 Top_Byte_Support_enum))
      Top_Poly_out_poly_out_size)
    (t2tb2 l2)))

;; "s1"
(assert
  (= (Top_List_size Top_Byte_byte1 (t2tb2 l1)) Top_Poly_in_poly_in_size))

;; "s2"
(assert
  (= (Top_List_size Top_Byte_byte1 (t2tb2 l2)) Top_Poly_out_poly_out_size))

;; "Top_Poly_in_ge0_poly_in_size"
(assert (<= 0 Top_Poly_in_poly_in_size))

;; "Top_Poly_out_ge0_poly_out_size"
(assert (<= 0 Top_Poly_out_poly_out_size))

;; "Top_Extra_block_extra_block_size"
(declare-fun Top_Extra_block_extra_block_size () Int)

;; "Top_Extra_block_ge0_extra_block_size"
(assert (<= 0 Top_Extra_block_extra_block_size))

;; Goal "goal"
(assert
  (not
  (= (ite (< Top_Poly_in_poly_in_size (+ Top_Poly_in_poly_in_size Top_Poly_out_poly_out_size))
       Top_Poly_in_poly_in_size
       (+ Top_Poly_in_poly_in_size Top_Poly_out_poly_out_size)) Top_Poly_in_poly_in_size)))

(check-sat)

