;; "A"
(declare-fun A2 (memory) A)

;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 (tuple30 Bool Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_TCR_H_K Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Bool Bool Top_DH_G_group Top_DH_GP_ZModE_exp Top_DH_G_group (tuple4 Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group) (tuple6 Top_TCR_H_K Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group) (tuple4 Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group) Bool) memory)) (et2 (tuple2 (tuple28 Bool Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_DH_GP_ZModE_exp Top_TCR_H_K Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Bool Bool Top_DH_G_group Top_DH_GP_ZModE_exp Top_DH_G_group (tuple4 Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group) (tuple6 Top_TCR_H_K Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group)) memory)))
    (=>
      (and (= (A2 (proj2_1 et2)) (A2 etm)) (= (A2 (proj2_1 et1)) (A2 etm)))
      (forall ((b0_L Bool) (b1_L Bool) (bqt_R Bool) (b0_R Bool))
        (=>
          (and
            (= (= b0_L true) (= b0_R true))
            (= (= bqt_R true) (= b1_L true)))
          (=
            (= (= b0_L true) (not (= b1_L true)))
            (not (= (= b0_R true) (= bqt_R true))))))))))

