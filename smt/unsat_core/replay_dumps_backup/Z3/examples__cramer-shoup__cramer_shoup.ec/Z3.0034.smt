(declare-datatypes ((tuple0 0))
  (((Tuple0))))

;; "tuple0"
(declare-fun tuple01 () ty)

;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 Bool memory)) (et2 (tuple2 tuple0 memory)))
    (=>
      (=>
        (not
          (or
            (not
              (= (Top_G3_slg3 (proj2_1 et2)) (as Top_Logic_None (Top_Logic_option (tuple3 Top_DH_G_group
                                             Top_DH_G_group Top_DH_G_group)))))
            (Top_List_mem1
              (Top_G3_slcilog (proj2_1 et2))
              (Tuple4
                (Top_G3_sla (proj2_1 et2))
                (Top_G3_sla_ (proj2_1 et2))
                (Top_G3_slc (proj2_1 et2))
                (Top_G3_sld (proj2_1 et2))))))
        (=>
          (= (Top_G1_slbad (proj2_1 et1)) true)
          (Top_List_mem2
            (Top_G3_sly2log (proj2_1 et2))
            (Top_G1_sly2 (proj2_1 et2)))))
      (=>
        (= (Top_G1_slbad (proj2_1 et1)) true)
        (or
          (not
            (= (Top_G3_slg3 (proj2_1 et2)) (as Top_Logic_None (Top_Logic_option (tuple3 Top_DH_G_group
                                           Top_DH_G_group Top_DH_G_group)))))
          (or
            (Top_List_mem1
              (Top_G3_slcilog (proj2_1 et2))
              (Tuple4
                (Top_G3_sla (proj2_1 et2))
                (Top_G3_sla_ (proj2_1 et2))
                (Top_G3_slc (proj2_1 et2))
                (Top_G3_sld (proj2_1 et2))))
            (Top_List_mem2
              (Top_G3_sly2log (proj2_1 et2))
              (Top_G1_sly2 (proj2_1 et2))))))))))

(check-sat)

