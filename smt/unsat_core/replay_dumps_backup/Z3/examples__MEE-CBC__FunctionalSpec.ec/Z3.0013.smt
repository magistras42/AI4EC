(declare-sort uni 0)

(declare-sort ty 0)

;; "sort"
(declare-fun sort (ty
  uni) Bool)

;; "witness"
(declare-fun witness (ty) uni)

;; "witness_sort"
(assert (forall ((a ty)) (sort a (witness a))))

;; "int"
(declare-fun int () ty)

;; "witness"
(declare-fun witness1 (ty) uni)

;; "witness_sort"
(assert (forall ((ta ty)) (sort ta (witness1 ta))))

;; "Top_n"
(declare-fun Top_n () Int)

;; "Top_ge0_n"
(assert (<= 0 Top_n))

;; Goal "goal"
(assert
  (not (< 1 (+ Top_n 3))))

(check-sat)

