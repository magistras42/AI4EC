  Top_DH_G_group))

;; "Top_OTP_OTP_Initiator_/st"
(declare-fun Top_OTP_OTP_Initiator_slst (memory) Top_OTP_iscstate)

;; "Top_DHKE_FKE_FKE_/st"
(declare-fun Top_DHKE_FKE_FKE_slst (memory) Top_DHKE_FKE_state)

;; "Top_OTP_GenEager_RO_/m"
(declare-fun Top_OTP_GenEager_RO_slm (memory) (Top_FMap_fmap tuple0
  Top_DH_G_group))

;; "Top_FMap_tomap"
(declare-fun Top_FMap_tomap (ty
  ty
  uni) uni)

;; "Top_FMap_tomap_sort"
(assert
  (forall ((qta1 ty) (qtb1 ty))
    (forall ((x uni))
      (sort
        (infix_mngt qta1 (Top_Logic_option1 qtb1))
        (Top_FMap_tomap qtb1 qta1 x)))))

;; "Top_FMap___[_]"
(declare-fun Top_FMap___lb_rb (ty
  ty
  uni
  uni) uni)

;; "Top_FMap___[_]_sort"
(assert
  (forall ((qta1 ty) (qtb1 ty))
    (forall ((x uni) (x1 uni))
      (sort (Top_Logic_option1 qtb1) (Top_FMap___lb_rb qtb1 qta1 x x1)))))

;; "Top_FMap___[_]'def"
(assert
  (forall ((qta1 ty) (qtb1 ty))
    (forall ((m uni) (x uni))
      (= (Top_FMap___lb_rb qtb1 qta1 m x) (infix_at
                                            (Top_Logic_option1 qtb1)
                                            qta1
                                            (Top_FMap_tomap qtb1 qta1 m)
                                            x)))))

;; "Top_FMap_dom"
(declare-fun Top_FMap_dom (ty
  ty
  uni
  uni) Bool)

;; "Top_FMap_dom"
(declare-fun Top_FMap_dom1 ((Top_FMap_fmap tuple0
  Top_DH_G_group)
  tuple0) Bool)

;; "t2tb"
(declare-fun t2tb ((Top_Logic_option Top_DH_G_group)) uni)

;; "t2tb_sort"
(assert
  (forall ((x (Top_Logic_option Top_DH_G_group)))
    (sort (Top_Logic_option1 Top_DH_G_group1) (t2tb x))))

;; "tb2t"
(declare-fun tb2t (uni) (Top_Logic_option Top_DH_G_group))

;; "BridgeL"
(assert
  (forall ((i (Top_Logic_option Top_DH_G_group)))
    (! (= (tb2t (t2tb i)) i) :pattern ((t2tb i)) )))

;; "BridgeR"
(assert
  (forall ((j uni))
    (! (=>
         (sort (Top_Logic_option1 Top_DH_G_group1) j)
         (= (t2tb (tb2t j)) j)) :pattern ((t2tb (tb2t j))) )))

;; "t2tb"
(declare-fun t2tb1 (tuple0) uni)

;; "t2tb_sort"
(assert (forall ((x tuple0)) (sort tuple01 (t2tb1 x))))

;; "tb2t"
(declare-fun tb2t1 (uni) tuple0)

;; "BridgeL"
(assert
  (forall ((i tuple0)) (! (= (tb2t1 (t2tb1 i)) i) :pattern ((t2tb1 i)) )))

;; "BridgeR"
(assert
  (forall ((j uni))
    (! (=> (sort tuple01 j) (= (t2tb1 (tb2t1 j)) j)) :pattern ((t2tb1
                                                                 (tb2t1 j))) )))

;; "t2tb"
(declare-fun t2tb2 ((Top_FMap_fmap tuple0
  Top_DH_G_group)) uni)

;; "t2tb_sort"
(assert
  (forall ((x (Top_FMap_fmap tuple0 Top_DH_G_group)))
    (sort (Top_FMap_fmap1 tuple01 Top_DH_G_group1) (t2tb2 x))))

;; "tb2t"
(declare-fun tb2t2 (uni) (Top_FMap_fmap tuple0
  Top_DH_G_group))

;; "BridgeL"
(assert
  (forall ((i (Top_FMap_fmap tuple0 Top_DH_G_group)))
    (! (= (tb2t2 (t2tb2 i)) i) :pattern ((t2tb2 i)) )))

;; "BridgeR"
(assert
  (forall ((j uni))
    (! (=>
         (sort (Top_FMap_fmap1 tuple01 Top_DH_G_group1) j)
         (= (t2tb2 (tb2t2 j)) j)) :pattern ((t2tb2 (tb2t2 j))) )))

;; "Top_FMap_dom'def"
(assert
  (forall ((m (Top_FMap_fmap tuple0 Top_DH_G_group)) (x tuple0))
    (=
      (Top_FMap_dom1 m x)
      (not
        (= (tb2t
             (Top_FMap___lb_rb Top_DH_G_group1 tuple01 (t2tb2 m) (t2tb1 x))) 
        (tb2t
          (Top_Logic_None Top_DH_G_group1)))))))

;; "Top_FMap_dom'def"
(assert
  (forall ((qta1 ty) (qtb1 ty))
    (forall ((m uni) (x uni))
      (=
        (Top_FMap_dom qtb1 qta1 m x)
        (not (= (Top_FMap___lb_rb qtb1 qta1 m x) (Top_Logic_None qtb1)))))))

;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 (Top_Composition_sum Top_role (Top_Composition_sum tuple0 tuple0)) memory)) (et2 (tuple2 (Top_Composition_sum Top_role (Top_Composition_sum tuple0 tuple0)) memory)))
    (=>
      (and
        (= (proj2_0 et1) (proj2_0 et2))
        (and
          (and
            (= (Top_DHKE_FKE_FKEAuth_FChan_FAuth_FAuth_slst (proj2_1 et1)) 
            (Top_DHKE_FKE_FKEAuth_FChan_FAuth_FAuth_slst
              (proj2_1 et2)))
            (and
              (and
                (= (Top_OTP_OTP_Initiator_slp (proj2_1 et1)) (Top_OTP_OTP_Initiator_slp
                                                               (proj2_1 et2)))
                (= (Top_OTP_OTP_Initiator_slst (proj2_1 et1)) (Top_OTP_OTP_Initiator_slst
                                                                (proj2_1 et2))))
              (= (Top_DHKE_FKE_FKE_slst (proj2_1 et1)) (Top_DHKE_FKE_FKE_slst
                                                         (proj2_1 et2)))))
          (=
            (Top_FMap_dom1 (Top_OTP_GenEager_RO_slm (proj2_1 et1)) Tuple0)
            (= (Top_OTP_OTP_Initiator_slst (proj2_1 et1)) Top_OTP_ISCDone))))
      (=
        (exists ((m2 (Top_Composition_sum tuple0 tuple0)))
          (= (proj2_0 et1) ((as Top_Composition_Right
                             (Top_Composition_sum Top_role
                             (Top_Composition_sum tuple0
                             tuple0)))
                             m2)))
        (exists ((m2 (Top_Composition_sum tuple0 tuple0)))
          (= (proj2_0 et2) ((as Top_Composition_Right
                             (Top_Composition_sum Top_role
                             (Top_Composition_sum tuple0
                             tuple0)))
                             m2))))))))

(check-sat)

