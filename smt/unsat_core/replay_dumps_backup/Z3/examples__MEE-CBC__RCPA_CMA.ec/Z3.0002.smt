(assert (forall ((x Real)) (< (+ x (- 1.0)) (to_real (Top_Real_floor x)))))

;; "Top_Real_isint"
(declare-fun Top_Real_isint (Real) Bool)

;; "Top_Real_isint'def"
(assert
  (forall ((x Real))
    (= (Top_Real_isint x) (exists ((n Int)) (= x (to_real n))))))

;; "Top_Real_floor_eqP"
(assert
  (forall ((x Real))
    (= (= (to_real (Top_Real_floor x)) x) (Top_Real_isint x))))

;; "Top_Real_floor_bound"
(assert
  (forall ((x Real))
    (and
      (< (+ x (- 1.0)) (to_real (Top_Real_floor x)))
      (<= (to_real (Top_Real_floor x)) x))))

;; "Top_Real_floorP"
(assert
  (forall ((x Real) (n Int))
    (=
      (= (Top_Real_floor x) n)
      (and (<= (to_real n) x) (< x (+ (to_real n) 1.0))))))

;; "Top_Real_eq_fromint"
(assert
  (forall ((z1 Int) (z2 Int)) (= (= (to_real z1) (to_real z2)) (= z1 z2))))

;; "Top_Real_divrK"
(assert
  (forall ((u Real) (v Real))
    (=> (not (= v 0.0)) (= u (* (* u (/ 1.0 v)) v)))))

;; "Top_Real_divr0"
(assert (forall ((x Real)) (= (* x (/ 1.0 0.0)) 0.0)))

;; "Top_Real_ceil_lt"
(assert (forall ((x Real)) (< (to_real (Top_Real_ceil x)) (+ x 1.0))))

;; "Top_Real_ceil_ge"
(assert (forall ((x Real)) (<= x (to_real (Top_Real_ceil x)))))

;; "Top_Real_ceil_eqP"
(assert
  (forall ((x Real))
    (= (= (to_real (Top_Real_ceil x)) x) (Top_Real_isint x))))

;; "Top_Real_ceil_bound"
(assert
  (forall ((x Real))
    (and
      (<= x (to_real (Top_Real_ceil x)))
      (< (to_real (Top_Real_ceil x)) (+ x 1.0)))))

;; "Top_Real_b2r_ge0"
(assert
  (forall ((b Bool)) (<= 0.0 (ite (= b true) (to_real 1) (to_real 0)))))

;; "Top_Real_b2rE"
(assert
  (forall ((b Bool))
    (= (ite (= b true) (to_real 1) (to_real 0)) (to_real (Top_Int_b2i b)))))

;; "Top_Real_b2r1"
(assert (= (to_real 1) 1.0))

;; "Top_Real_b2r0"
(assert (= (to_real 0) 0.0))

;; "Div_unique"
(assert
  (forall ((x Int) (y Int) (q Int))
    (=>
      (< 0 y)
      (=> (and (<= (* q y) x) (< x (+ (* q y) y))) (= (div x y) q)))))

;; "Div_bound"
(assert
  (forall ((x Int) (y Int))
    (=> (and (<= 0 x) (< 0 y)) (and (<= 0 (div x y)) (<= (div x y) x)))))

;; "Div_inf"
(assert
  (forall ((x Int) (y Int)) (=> (and (<= 0 x) (< x y)) (= (div x y) 0))))

;; "Div_inf_neg"
(assert
  (forall ((x Int) (y Int))
    (=> (and (< 0 x) (<= x y)) (= (div (- x) y) (- 1)))))

;; "Mod_0"
(assert (forall ((y Int)) (=> (not (= y 0)) (= (mod 0 y) 0))))

;; "Div_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div 1 y) 0))))

;; "Div_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div (- 1) y) (- 1)))))

;; "Mod_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod 1 y) 1))))

;; "Mod_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod (- 1) y) (- y 1)))))

;; "Div_mult"
(assert
  (forall ((x Int) (y Int) (z Int))
    (! (=> (< 0 x) (= (div (+ (* x y) z) x) (+ y (div z x)))) :pattern ((div (+ (* x y) z) x)) )))

;; "Mod_mult"
(assert
  (forall ((x Int) (y Int) (z Int))
    (! (=> (< 0 x) (= (mod (+ (* x y) z) x) (mod z x))) :pattern ((mod (+ (* x y) z) x)) )))

;; "Top_IntDiv_%|"
(declare-fun Top_IntDiv_pcbr (Int
  Int) Bool)

;; "Top_IntDiv_%|'def"
(assert (forall ((m Int) (d Int)) (= (Top_IntDiv_pcbr m d) (= (mod d m) 0))))

;; "Top_IntDiv_fromint_div"
(assert
  (forall ((x Int) (y Int))
    (=>
      (Top_IntDiv_pcbr y x)
      (= (to_real (div x y)) (* (to_real x) (/ 1.0 (to_real y)))))))

;; "Top_IntDiv_prime"
(declare-fun Top_IntDiv_prime (Int) Bool)

;; "Top_IntDiv_prime'def"
(assert
  (forall ((a Int))
    (=
      (Top_IntDiv_prime a)
      (and
        (< 1 a)
        (forall ((q Int))
          (=>
            (Top_IntDiv_pcbr q a)
            (or (= (Top_CoreInt_absz q) 1) (= (Top_CoreInt_absz q) a))))))))

;; "Top_IntDiv_Euclide_prod"
(assert
  (forall ((qta ty))
    (forall ((F uni) (s uni) (a Int))
      (=>
        (Top_IntDiv_pcbr
          a
          (Top_StdBigop_Bigint_BIM_big qta (Top_Logic_predT_ho qta) F s))
        (=>
          (Top_IntDiv_prime a)
          (exists ((x uni))
            (and
              (sort qta x)
              (and
                (Top_List_mem qta s x)
                (Top_IntDiv_pcbr a (tb2t7 (infix_at int qta F x)))))))))))

;; "Top_List_has_predT"
(assert
  (forall ((qta ty))
    (forall ((s uni))
      (=
        (Top_List_has qta (Top_Logic_predT_ho qta) s)
        (< 0 (Top_List_size qta s))))))

;; "Top_List_filter_predT"
(assert
  (forall ((qta ty))
    (forall ((s uni)) (= (Top_List_filter qta (Top_Logic_predT_ho qta) s) s))))

;; "Top_List_count_predT"
(assert
  (forall ((qta ty))
    (forall ((s uni))
      (= (Top_List_count qta (Top_Logic_predT_ho qta) s) (Top_List_size
                                                           qta
                                                           s)))))

;; "Top_List_all_predT"
(assert
  (forall ((qta ty))
    (forall ((s uni)) (Top_List_all qta (Top_Logic_predT_ho qta) s))))

;; Goal "goal"
(assert
  (not (forall ((p Top_MtE_leaks)) (Top_Distr_is_lossless1 (Top_MtE_dC p)))))

(check-sat)

