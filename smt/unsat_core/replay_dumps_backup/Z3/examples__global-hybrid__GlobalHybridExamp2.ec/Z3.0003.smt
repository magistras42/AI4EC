        (= (Top_Hybrid_Or_slctr (proj2_1 et2)) (Top_Hybrid_sli (proj2_1 et2))))
      (forall ((xL Top_exp))
        (=>
          (Top_Distr_support1 Top_dexp xL)
          (forall ((yL Top_exp))
            (=>
              (Top_Distr_support1 Top_dexp yL)
              (and
                (= (+ (Top_OrReal_slctr (proj2_1 et1)) 1) (+ (Top_Hybrid_Or_slctr
                                                               (proj2_1 et2)) 1))
                (and
                  (and
                    (<= 1 (+ (Top_OrReal_slctr (proj2_1 et1)) 1))
                    (<= (+ (Top_OrReal_slctr (proj2_1 et1)) 1) (+ Top_m 1)))
                  (= (Top_Hybrid_sli (proj2_1 et2)) 1)))))))))))

