;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 (tuple3 Top_key Top_key Top_key) memory)) (et2 (tuple2 (tuple6 (tuple3 Top_key Top_key Top_key) Top_exp Top_exp Top_exp Top_exp Top_exp) memory)))
