(declare-fun Top_FMap_ofmap1 ((Array Top_ro_in_t (Top_Logic_option Top_exp))) (Top_FMap_fmap Top_ro_in_t
  Top_exp))

(declare-datatypes ((tuple0 0))
  (((Tuple0))))

;; "tuple0"
(declare-fun tuple01 () ty)

;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 (tuple6 tuple0 Int Bool tuple0 Int Bool) memory)) (et2 (tuple2 (tuple7 Int Bool Int Bool Top_ro_in_t Top_ro_in_t Top_ro_in_t) memory)))
    (=>
      (and
        (= (Adv2 (proj2_1 et1)) (Adv2 (proj2_1 et2)))
        (and
          (= (Top_Hybrid_sli (proj2_1 et1)) iqt)
          (and
            (= (Top_RO_Disting2_sli (proj2_1 et2)) iqt)
            (and
              (= (Top_Hybrid_Or_slctr (proj2_1 et1)) 1)
              (and
                (= (Top_RO_Disting2_Or_slctr (proj2_1 et2)) 1)
                (= (Top_FullRO_RO_slm (proj2_1 et2)) (Top_FMap_ofmap1
                                                       (const2
                                                         (as Top_Logic_None (Top_Logic_option Top_exp))))))))))
      (and
        (and
          (= (Adv2 (proj2_1 et1)) (Adv2 (proj2_1 et2)))
          (and
            (= (Top_Hybrid_Or_slctr (proj2_1 et1)) (Top_RO_Disting2_Or_slctr
                                                     (proj2_1 et2)))
            (and
              (and
                (<= 1 (Top_Hybrid_Or_slctr (proj2_1 et1)))
                (<= (Top_Hybrid_Or_slctr (proj2_1 et1)) (+ Top_m 1)))
              (and
                (= (Top_Hybrid_sli (proj2_1 et1)) iqt)
                (and
                  (= (Top_RO_Disting2_sli (proj2_1 et2)) iqt)
                  (=>
                    (<= (Top_Hybrid_Or_slctr (proj2_1 et1)) iqt)
                    (= (Top_FullRO_RO_slm (proj2_1 et2)) (Top_FMap_ofmap1
                                                           (const2
                                                             (as Top_Logic_None (Top_Logic_option Top_exp)))))))))))
        (forall ((result_L Bool) (result_R Bool) (Adv_L Adv) (ctr_L Int) (Adv_R Adv) (ctr_R Int) (m_R (Top_FMap_fmap Top_ro_in_t Top_exp)))
          (=>
            (and
              (= (= result_L true) (= result_R true))
              (and
                (= Adv_L Adv_R)
                (and
                  (= ctr_L ctr_R)
                  (and
                    (and (<= 1 ctr_L) (<= ctr_L (+ Top_m 1)))
                    (and
                      (= (Top_Hybrid_sli (proj2_1 et1)) iqt)
                      (and
                        (= (Top_RO_Disting2_sli (proj2_1 et2)) iqt)
                        (=>
                          (<= ctr_L iqt)
                          (= m_R (Top_FMap_ofmap1
                                   (const2
                                     (as Top_Logic_None (Top_Logic_option Top_exp))))))))))))
            (= (= result_L true) (= result_R true)))))))))

(check-sat)

