;; "Top_FMap_dom'def"
(assert
  (forall ((qta1 ty))
    (forall ((m uni) (x1 uni))
      (=
        (Top_FMap_dom Top_exp1 qta1 m x1)
        (not
          (= (tb2t (Top_FMap___lb_rb Top_exp1 qta1 m x1)) (as Top_Logic_None (Top_Logic_option Top_exp))))))))

;; "Top_FMap_dom'def"
(assert
  (forall ((m (Top_FMap_fmap Top_ro_in_t Top_exp)) (x1 Top_ro_in_t))
    (=
      (Top_FMap_dom1 m x1)
      (not
        (= (Top_FMap___lb_rb1 m x1) (as Top_Logic_None (Top_Logic_option Top_exp)))))))

;; "Top_FMap_dom'def"
(assert
  (forall ((qta1 ty) (qtb ty))
    (forall ((m uni) (x1 uni))
      (=
        (Top_FMap_dom qtb qta1 m x1)
        (not (= (Top_FMap___lb_rb qtb qta1 m x1) (Top_Logic_None1 qtb)))))))

;; "Top_FMap_mem_empty"
(assert
  (forall ((qta1 ty))
    (forall ((x1 uni))
      (not
        (Top_FMap_dom
          Top_exp1
          qta1
          (Top_FMap_ofmap
            Top_exp1
            qta1
            (const1
              (Top_Logic_option1 Top_exp1)
              qta1
              (t2tb (as Top_Logic_None (Top_Logic_option Top_exp)))))
          x1)))))

;; "Top_FMap_mem_empty"
(assert
  (forall ((x1 Top_ro_in_t))
    (not
      (Top_FMap_dom1
        (Top_FMap_ofmap1
          (const2 (as Top_Logic_None (Top_Logic_option Top_exp))))
        x1))))

;; "Top_FMap_mem_empty"
(assert
  (forall ((qta1 ty) (qtb ty))
    (forall ((x1 uni))
      (not
        (Top_FMap_dom
          qtb
          qta1
          (Top_FMap_ofmap
            qtb
            qta1
            (const1 (Top_Logic_option1 qtb) qta1 (Top_Logic_None1 qtb)))
          x1)))))

;; "Top_FMap_mem_set"
(assert
  (forall ((m (Top_FMap_fmap Top_ro_in_t Top_exp)) (x1 Top_ro_in_t) (b Top_exp) (y Top_ro_in_t))
    (=
      (Top_FMap_dom1 (Top_FMap___lb_lsmn_rb1 m x1 b) y)
      (or (Top_FMap_dom1 m y) (= y x1)))))

;; "Top_FMap_mem_set"
(assert
  (forall ((qta1 ty) (qtb ty))
    (forall ((m uni) (x1 uni) (b uni) (y uni))
      (=>
        (sort qta1 x1)
        (=>
          (sort qta1 y)
          (=
            (Top_FMap_dom qtb qta1 (Top_FMap___lb_lsmn_rb qtb qta1 m x1 b) y)
            (or (Top_FMap_dom qtb qta1 m y) (= y x1))))))))

;; Goal "goal"
(assert
  (not
  (forall ((ethr (tuple2 (tuple8 (tuple3 Top_key Top_key Top_key) Top_exp Top_exp Top_exp Top_ro_in_t Top_exp Top_ro_in_t Top_exp) memory)))
    (=>
      (exists ((m_R (Top_FMap_fmap Top_ro_in_t Top_exp)))
        (and
          (= (Top_FullRO_RO_slm (proj2_1 ethr)) (Top_FMap___lb_lsmn_rb1
                                                  m_R
                                                  (proj8_4 (proj2_0 ethr))
                                                  (proj8_5 (proj2_0 ethr))))
          (and
            (= (proj8_1 (proj2_0 ethr)) (Top_Logic_odflt1
                                          witness2
                                          (Top_FMap___lb_rb1
                                            (Top_FullRO_RO_slm
                                              (proj2_1 ethr))
                                            (proj8_4 (proj2_0 ethr)))))
            (and
              (= (proj8_6 (proj2_0 ethr)) Top_B)
              (and
                (and
                  (and
                    (and
                      (and
                        (= (Top_Hybrid_Or_slctr (proj2_1 etm)) (Top_RO_Disting1_Or_slctr
                                                                 (proj2_1
                                                                   ethr)))
                        (and
                          (and
                            (<= 1 (Top_Hybrid_Or_slctr (proj2_1 etm)))
                            (<= (Top_Hybrid_Or_slctr (proj2_1 etm)) (+ 
                            Top_m 1)))
                          (and
                            (= (Top_Hybrid_sli (proj2_1 etm)) iqt)
                            (and
                              (= (Top_RO_Disting1_sli (proj2_1 ethr)) 
                              iqt)
                              (=>
                                (<= (Top_Hybrid_Or_slctr (proj2_1 etm)) 
                                iqt)
                                (= m_R (Top_FMap_ofmap1
                                         (const2
                                           (as Top_Logic_None (Top_Logic_option Top_exp))))))))))
                      (<= (Top_Hybrid_Or_slctr (proj2_1 etm)) Top_m))
                    (not
                      (< (Top_Hybrid_Or_slctr (proj2_1 etm)) (Top_Hybrid_sli
                                                               (proj2_1 etm)))))
                  (= (Top_Hybrid_Or_slctr (proj2_1 etm)) (Top_Hybrid_sli
                                                           (proj2_1 etm))))
                (and
                  (= (proj6_4 (proj2_0 etm)) (proj8_5 (proj2_0 ethr)))
                  (and
                    (= (proj6_5 (proj2_0 etm)) (proj8_7 (proj2_0 ethr)))
                    (= (proj8_4 (proj2_0 ethr)) Top_A))))))))
      (not
        (Top_FMap_dom1
          (Top_FullRO_RO_slm (proj2_1 ethr))
          (proj8_6 (proj2_0 ethr))))))))

(check-sat)

