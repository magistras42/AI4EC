  (forall ((a14 ty) (a15 ty) (a16 ty) (a17 ty))
    (forall ((u uni) (u1 uni) (u2 uni) (u3 uni))
      (=>
        (sort a15 u2)
        (= (proj4_21 a17 a16 a15 a14 (Tuple41 a17 a16 a15 a14 u u1 u2 u3)) u2)))))

;; "proj4_3"
(declare-fun proj4_31 (ty
  ty
  ty
  ty
  uni) uni)

;; "proj4_3_sort"
(assert
  (forall ((a14 ty) (a15 ty) (a16 ty) (a17 ty))
    (forall ((x uni)) (sort a14 (proj4_31 a17 a16 a15 a14 x)))))

;; "proj4_3'def"
(assert
  (forall ((a14 ty) (a15 ty) (a16 ty) (a17 ty))
    (forall ((u uni) (u1 uni) (u2 uni) (u3 uni))
      (=>
        (sort a14 u3)
        (= (proj4_31 a17 a16 a15 a14 (Tuple41 a17 a16 a15 a14 u u1 u2 u3)) u3)))))

;; "tuple4_inversion"
(assert
  (forall ((a14 ty) (a15 ty) (a16 ty) (a17 ty))
    (forall ((u uni))
      (=>
        (sort (tuple41 a17 a16 a15 a14) u)
        (= u (Tuple41
               a17
               a16
               a15
               a14
               (proj4_01 a17 a16 a15 a14 u)
               (proj4_11 a17 a16 a15 a14 u)
               (proj4_21 a17 a16 a15 a14 u)
               (proj4_31 a17 a16 a15 a14 u)))))))

