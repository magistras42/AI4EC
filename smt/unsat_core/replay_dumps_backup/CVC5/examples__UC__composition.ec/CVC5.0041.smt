;; "_"
(assert
  (and
    (= (proj8_0 (proj2_0 bqet1)) (proj4_0 (proj2_0 bqet2)))
    (and
      (= (F12 (proj2_1 bqet1)) (F12 (proj2_1 bqet2)))
      (and
        (= (F22 (proj2_1 bqet1)) (F22 (proj2_1 bqet2)))
