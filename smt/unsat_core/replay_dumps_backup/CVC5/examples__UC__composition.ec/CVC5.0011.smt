    (forall ((u uni) (u1 uni) (u2 uni) (u3 uni) (u4 uni) (u5 uni) (u6 uni) (u7 uni))
      (=>
        (sort a14 u7)
        (= (proj8_71
             a21
             a20
             a19
             a18
             a17
             a16
             a15
             a14
             (Tuple81 a21 a20 a19 a18 a17 a16 a15 a14 u u1 u2 u3 u4 u5 u6 u7)) u7)))))

;; "tuple8_inversion"
(assert
  (forall ((a14 ty) (a15 ty) (a16 ty) (a17 ty) (a18 ty) (a19 ty) (a20 ty) (a21 ty))
    (forall ((u uni))
      (=>
        (sort (tuple81 a21 a20 a19 a18 a17 a16 a15 a14) u)
        (= u (Tuple81
               a21
               a20
               a19
               a18
               a17
               a16
               a15
               a14
               (proj8_01 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_11 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_21 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_31 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_41 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_51 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_61 a21 a20 a19 a18 a17 a16 a15 a14 u)
               (proj8_71 a21 a20 a19 a18 a17 a16 a15 a14 u)))))))

(declare-sort Rho 0)

;; "Rho"
(declare-fun Rho1 () ty)

(declare-sort Ff 0)

;; "Ff"
(declare-fun Ff1 () ty)

(declare-sort Sf 0)

;; "Sf"
(declare-fun Sf1 () ty)

;; "witness"
(declare-fun witness1 (ty) uni)

;; "witness_sort"
(assert (forall ((ta ty)) (sort ta (witness1 ta))))

;; "&m"
(declare-fun etm () memory)

;; "m1"
(declare-fun m1 () Top_COMPOSITION_R_ask_backdoor)

;; "m2"
(declare-fun m2 () Top_COMPOSITION_R_ask_backdoor)

;; "&2"
(declare-fun et2 () (tuple2 (tuple4 (Top_sum Top_COMPOSITION_R_ask_backdoor
  Top_COMPOSITION_Pi_REAL_ask_backdoor)
  (Top_Logic_option Top_COMPOSITION_R_backdoor)
  (Top_Logic_option Top_COMPOSITION_Pi_REAL_backdoor)
  (Top_Logic_option (Top_sum Top_COMPOSITION_R_backdoor
  Top_COMPOSITION_Pi_REAL_backdoor)))
  memory))

;; "Rho"
(declare-fun Rho2 (memory) Rho)

;; "Ff"
(declare-fun Ff2 (memory) Ff)

;; "Sf"
(declare-fun Sf2 (memory) Sf)

;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 (tuple8 (Top_sum Top_COMPOSITION_R_ask_backdoor Top_COMPOSITION_Pi_REAL_ask_backdoor) (Top_Logic_option (Top_sum Top_COMPOSITION_R_backdoor Top_COMPOSITION_Pi_IDEAL_backdoor)) (Top_Logic_option Top_COMPOSITION_Pi_REAL_backdoor) (Top_Logic_option (Top_sum Top_COMPOSITION_R_backdoor Top_COMPOSITION_Pi_REAL_backdoor)) (Top_sum Top_COMPOSITION_R_ask_backdoor Top_COMPOSITION_Pi_IDEAL_ask_backdoor) (Top_Logic_option Top_COMPOSITION_R_backdoor) (Top_Logic_option Top_COMPOSITION_Pi_IDEAL_backdoor) (Top_Logic_option (Top_sum Top_COMPOSITION_R_backdoor Top_COMPOSITION_Pi_IDEAL_backdoor))) memory)))
    (=>
      (and
        (= (proj8_0 (proj2_0 et1)) ((as Top_Left
                                     (Top_sum Top_COMPOSITION_R_ask_backdoor
                                     Top_COMPOSITION_Pi_REAL_ask_backdoor))
                                     m1))
        (and
          (= (proj4_0 (proj2_0 et2)) ((as Top_Left
                                       (Top_sum Top_COMPOSITION_R_ask_backdoor
                                       Top_COMPOSITION_Pi_REAL_ask_backdoor))
                                       m2))
          (and
            (= (proj8_0 (proj2_0 et1)) (proj4_0 (proj2_0 et2)))
            (and
              (= (Rho2 (proj2_1 et1)) (Rho2 (proj2_1 et2)))
              (and
                (= (Ff2 (proj2_1 et1)) (Ff2 (proj2_1 et2)))
                (= (Sf2 (proj2_1 et1)) (Sf2 (proj2_1 et2))))))))
      (exists ((m11 Top_COMPOSITION_R_ask_backdoor)) (= m1 m11))))))

(check-sat)
