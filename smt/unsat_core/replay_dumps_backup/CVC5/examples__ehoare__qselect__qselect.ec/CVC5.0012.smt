          (= (Top_List_plpl qta (Top_List_clcl qta x s1) s2) (Top_List_clcl
                                                               qta
                                                               x
                                                               (Top_List_plpl
                                                                 qta
                                                                 s1
                                                                 s2))))))))

;; "Top_List_all"
(declare-fun Top_List_all (ty
  uni
  uni) Bool)

;; "Top_List_all'def"
(assert
  (forall ((qta ty))
    (forall ((p uni))
      (and
        (Top_List_all qta p (Top_List_lbrb qta))
        (forall ((y uni) (ys uni))
          (=
            (Top_List_all qta p (Top_List_clcl qta y ys))
            (and
              (= (tb2t6 (infix_at bool qta p y)) true)
              (Top_List_all qta p ys))))))))

