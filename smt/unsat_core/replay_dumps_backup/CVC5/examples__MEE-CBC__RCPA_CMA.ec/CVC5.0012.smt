;; "Div_unique"
(assert
  (forall ((x2 Int) (y Int) (q Int))
    (=>
      (< 0 y)
      (=> (and (<= (* q y) x2) (< x2 (+ (* q y) y))) (= (div x2 y) q)))))

;; "Div_bound"
(assert
  (forall ((x2 Int) (y Int))
    (=> (and (<= 0 x2) (< 0 y)) (and (<= 0 (div x2 y)) (<= (div x2 y) x2)))))

;; "Div_inf"
(assert
  (forall ((x2 Int) (y Int)) (=> (and (<= 0 x2) (< x2 y)) (= (div x2 y) 0))))

;; "Div_inf_neg"
(assert
  (forall ((x2 Int) (y Int))
    (=> (and (< 0 x2) (<= x2 y)) (= (div (- x2) y) (- 1)))))

;; "Mod_0"
(assert (forall ((y Int)) (=> (not (= y 0)) (= (mod 0 y) 0))))

;; "Div_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div 1 y) 0))))

;; "Div_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div (- 1) y) (- 1)))))

;; "Mod_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod 1 y) 1))))

;; "Mod_minus1_left"
