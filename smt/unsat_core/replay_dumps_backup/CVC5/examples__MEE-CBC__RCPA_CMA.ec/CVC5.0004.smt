  (forall ((x8 Int) (y Int)) (=> (and (<= 0 x8) (< x8 y)) (= (div x8 y) 0))))

;; "Div_inf_neg"
(assert
  (forall ((x8 Int) (y Int))
    (=> (and (< 0 x8) (<= x8 y)) (= (div (- x8) y) (- 1)))))

;; "Mod_0"
