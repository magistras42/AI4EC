;; "Top_FSet_card'def"
(assert
  (forall ((qta ty))
    (forall ((s uni))
      (= (Top_FSet_card qta s) (Top_List_size qta (Top_FSet_elems qta s))))))

;; "Top_qF"
(declare-fun Top_qF () Int)

;; "t2tb"
(declare-fun t2tb4 ((Top_FMap_fmap Top_seed
  (tuple2 Top_seed
  Top_output))) uni)

;; "t2tb_sort"
(assert
  (forall ((x1 (Top_FMap_fmap Top_seed (tuple2 Top_seed Top_output))))
    (sort
      (Top_FMap_fmap1 Top_seed1 (tuple21 Top_seed1 Top_output1))
      (t2tb4 x1))))

;; "tb2t"
(declare-fun tb2t4 (uni) (Top_FMap_fmap Top_seed
  (tuple2 Top_seed
  Top_output)))

;; "BridgeL"
(assert
  (forall ((i (Top_FMap_fmap Top_seed (tuple2 Top_seed Top_output))))
    (! (= (tb2t4 (t2tb4 i)) i) :pattern ((t2tb4 i)) )))

;; "BridgeR"
(assert
  (forall ((j uni))
    (! (=>
         (sort (Top_FMap_fmap1 Top_seed1 (tuple21 Top_seed1 Top_output1)) j)
         (= (t2tb4 (tb2t4 j)) j)) :pattern ((t2tb4 (tb2t4 j))) )))

;; "domF_le_qF"
(assert
  (<= (to_real (Top_FSet_card
                 Top_seed1
                 (Top_FMap_fdom
                   (tuple21 Top_seed1 Top_output1)
                   Top_seed1
                   (t2tb4 m)))) (to_real Top_qF)))

;; "Top_Support_enum"
(declare-fun Top_Support_enum () (Top_List_list Top_seed))

;; "Top_Support_card_gt0"
(assert (< 0 (Top_List_size1 Top_Support_enum)))

;; Goal "goal"
(assert
  (not (<= 0.0 (to_real (Top_List_size1 Top_Support_enum)))))

(check-sat)
(get-info :reason-unknown)

