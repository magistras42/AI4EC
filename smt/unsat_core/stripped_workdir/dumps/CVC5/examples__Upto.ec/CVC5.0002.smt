;; "Top_RealExp_is_pow"
(declare-fun Top_RealExp_is_pow (Int
  Int) Bool)

;; "Top_RealExp_is_pow'def"
(assert
  (forall ((b Int) (x7 Int))
    (=
      (Top_RealExp_is_pow b x7)
      (= (Top_Ring_IntID_exp b (Top_RealExp_ilog b x7)) x7))))

;; "Top_RealExp_is_powP"
(assert
  (forall ((b Int) (x7 Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x7)
        (=
          (Top_RealExp_is_pow b x7)
          (exists ((n Int)) (and (<= 0 n) (= x7 (Top_Ring_IntID_exp b n)))))))))

;; "Top_RealExp_ilog_small"
(assert
  (forall ((b Int) (x7 Int))
    (=> (< 1 b) (=> (and (< 0 x7) (< x7 b)) (= (Top_RealExp_ilog b x7) 0)))))

;; "Top_RealExp_ilog_powK"
(assert
  (forall ((b Int) (n Int))
    (=>
      (< 1 b)
      (=> (<= 0 n) (= (Top_RealExp_ilog b (Top_Ring_IntID_exp b n)) n)))))

;; "Top_RealExp_ilog_mulr"
(assert
  (forall ((b Int) (x7 Int) (y Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x7)
        (=>
          (< 0 y)
          (=>
            (Top_RealExp_is_pow b y)
            (= (Top_RealExp_ilog b (* x7 y)) (+ (Top_RealExp_ilog b x7) 
            (Top_RealExp_ilog
              b
              y)))))))))

;; "Top_RealExp_ilog_mull"
(assert
  (forall ((b Int) (x7 Int) (y Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x7)
        (=>
          (< 0 y)
          (=>
            (Top_RealExp_is_pow b x7)
            (= (Top_RealExp_ilog b (* x7 y)) (+ (Top_RealExp_ilog b x7) 
            (Top_RealExp_ilog
              b
              y)))))))))

;; "Top_RealExp_ilog_mono"
(assert
  (forall ((b Int) (x7 Int) (y Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x7)
        (=> (<= x7 y) (<= (Top_RealExp_ilog b x7) (Top_RealExp_ilog b y)))))))

;; "Top_RealExp_ilog_ge0"
(assert
  (forall ((b Int) (x7 Int))
    (=> (<= 1 b) (=> (<= 1 x7) (<= 0 (Top_RealExp_ilog b x7))))))

;; "Top_RealExp_ilog_eq"
(assert
  (forall ((b Int) (x7 Int) (n Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x7)
        (=>
          (<= 0 n)
          (=
            (= (Top_RealExp_ilog b x7) n)
            (and
              (<= (Top_Ring_IntID_exp b n) x7)
              (< x7 (Top_Ring_IntID_exp b (+ n 1))))))))))

;; "Div_unique"
(assert
  (forall ((x7 Int) (y Int) (q Int))
    (=>
      (< 0 y)
      (=> (and (<= (* q y) x7) (< x7 (+ (* q y) y))) (= (div x7 y) q)))))

;; "Div_bound"
(assert
  (forall ((x7 Int) (y Int))
    (=> (and (<= 0 x7) (< 0 y)) (and (<= 0 (div x7 y)) (<= (div x7 y) x7)))))

;; "Div_inf"
(assert
  (forall ((x7 Int) (y Int)) (=> (and (<= 0 x7) (< x7 y)) (= (div x7 y) 0))))

;; "Div_inf_neg"
(assert
  (forall ((x7 Int) (y Int))
    (=> (and (< 0 x7) (<= x7 y)) (= (div (- x7) y) (- 1)))))

;; "Mod_0"
(assert (forall ((y Int)) (=> (not (= y 0)) (= (mod 0 y) 0))))

;; "Div_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div 1 y) 0))))

;; "Div_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div (- 1) y) (- 1)))))

;; "Mod_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod 1 y) 1))))

;; "Mod_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod (- 1) y) (- y 1)))))

;; "Div_mult"
(assert
  (forall ((x7 Int) (y Int) (z Int))
    (! (=> (< 0 x7) (= (div (+ (* x7 y) z) x7) (+ y (div z x7)))) :pattern ((div (+ (* x7 y) z) x7)) )))

;; "Mod_mult"
(assert
  (forall ((x7 Int) (y Int) (z Int))
    (! (=> (< 0 x7) (= (mod (+ (* x7 y) z) x7) (mod z x7))) :pattern ((mod (+ (* x7 y) z) x7)) )))

;; "Top_RealExp_ilog_dvd"
(assert
  (forall ((b Int) (x7 Int))
    (=>
      (< 0 x7)
      (=>
        (< 1 b)
        (=>
          (<= b x7)
          (= (Top_RealExp_ilog b x7) (+ (Top_RealExp_ilog b (div x7 b)) 1)))))))

;; "Top_RealExp_ilog_b"
(assert (forall ((b Int)) (=> (< 1 b) (= (Top_RealExp_ilog b b) 1))))

;; "Top_RealExp_ilogP"
(assert
  (forall ((b Int) (x7 Int))
    (=>
      (< 1 b)
      (=>
        (<= 1 x7)
        (and
          (<= (Top_Ring_IntID_exp b (Top_RealExp_ilog b x7)) x7)
