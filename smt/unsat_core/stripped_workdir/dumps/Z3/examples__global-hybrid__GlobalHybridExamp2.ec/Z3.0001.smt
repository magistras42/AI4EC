;; Goal "goal"
(assert
  (not
  (forall ((et1 (tuple2 Bool memory)) (et2 (tuple2 (tuple6 tuple0 Int Bool tuple0 Int Bool) memory)))
    (=>
      (and
        (= (Adv2 (proj2_1 et1)) (Adv2 (proj2_1 et2)))
        (and
          (= (Top_OrReal_slctr (proj2_1 et1)) (Top_Hybrid_Or_slctr
