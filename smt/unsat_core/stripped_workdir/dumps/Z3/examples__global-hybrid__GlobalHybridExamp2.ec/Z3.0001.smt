            (= (Top_Hybrid_sli (proj2_1 et2)) 1))))
      (and
        (and
          (= (Adv2 (proj2_1 et1)) (Adv2 (proj2_1 et2)))
          (and
            (= (Top_OrReal_slctr (proj2_1 et1)) (Top_Hybrid_Or_slctr
                                                  (proj2_1 et2)))
            (and
              (and
                (<= 1 (Top_OrReal_slctr (proj2_1 et1)))
                (<= (Top_OrReal_slctr (proj2_1 et1)) (+ Top_m 1)))
              (= (Top_Hybrid_sli (proj2_1 et2)) 1))))
        (forall ((result_L Bool) (result_R Bool) (Adv_L Adv) (ctr_L Int) (Adv_R Adv) (ctr_R Int))
          (=>
            (and
              (= (= result_L true) (= result_R true))
              (and
                (= Adv_L Adv_R)
                (and
                  (= ctr_L ctr_R)
                  (and
                    (and (<= 1 ctr_L) (<= ctr_L (+ Top_m 1)))
                    (= (Top_Hybrid_sli (proj2_1 et2)) 1)))))
            (= (= result_L true) (= result_R true)))))))))

