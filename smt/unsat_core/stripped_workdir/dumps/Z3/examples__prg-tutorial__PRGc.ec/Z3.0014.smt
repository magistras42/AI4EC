        (= (infix_at
             (infix_mngt qta bool)
             (Top_FMap_fmap qta qtb)
             (Top_FMap_dom_ho qtb qta)
             m) (infix_at
                  (infix_mngt qta bool)
                  (Top_List_list1 qta)
                  (Top_List_mem_ho_ho qta)
                  logP))
        (Top_inv qtb qta m logP)))))

