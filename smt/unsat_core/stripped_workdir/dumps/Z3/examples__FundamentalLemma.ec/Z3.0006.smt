(assert (forall ((y Int)) (=> (< 1 y) (= (mod (- 1) y) (- y 1)))))

;; "Div_mult"
(assert
  (forall ((x Int) (y Int) (z Int))
    (! (=> (< 0 x) (= (div (+ (* x y) z) x) (+ y (div z x)))) :pattern ((div (+ (* x y) z) x)) )))

;; "Mod_mult"
(assert
  (forall ((x Int) (y Int) (z Int))
    (! (=> (< 0 x) (= (mod (+ (* x y) z) x) (mod z x))) :pattern ((mod (+ (* x y) z) x)) )))

;; "Top_IntDiv_%|"
(declare-fun Top_IntDiv_pcbr (Int
  Int) Bool)

;; "Top_IntDiv_%|'def"
(assert (forall ((m Int) (d Int)) (= (Top_IntDiv_pcbr m d) (= (mod d m) 0))))

;; "Top_IntDiv_fromint_div"
(assert
  (forall ((x Int) (y Int))
    (=>
      (Top_IntDiv_pcbr y x)
      (= (to_real (div x y)) (* (to_real x) (/ 1.0 (to_real y)))))))

;; "Top_List_maxr_seq"
(assert
  (forall ((qta ty))
    (forall ((f uni) (s uni) (x0 uni))
      (=>
        (Top_List_mem qta s x0)
        (exists ((x uni))
          (and
            (sort qta x)
            (and
              (Top_List_mem qta s x)
              (forall ((y uni))
                (=>
                  (Top_List_mem qta s y)
                  (<= (tb2t7 (infix_at real qta f y)) (tb2t7
                                                        (infix_at
                                                          real
                                                          qta
                                                          f
                                                          x))))))))))))

;; "x"
(declare-fun x () Bool)

;; "Top_Pr_split"
(assert x)

;; Goal "goal"
(assert
  (not
  (<= (Top_Real_bqbr_br
        (+ (mu1 (G1_slmain Tuple0 etm) unamed_lambda) (- (mu1
                                                           (G2_slmain
                                                             Tuple0
                                                             etm)
                                                           unamed_lambda1)))) 
  (Top_max
    (mu1 (G1_slmain Tuple0 etm) unamed_lambda)
    (mu1 (G2_slmain Tuple0 etm) unamed_lambda1)))))

(check-sat)

