        (= (Top_List_count qta2 p s) (Top_List_size qta2 s))))))

;; "Top_List_all_count"
(assert
  (forall ((p (Array qtb Bool)) (s (Top_List_list qtb)))
    (=
      (Top_List_all qtb1 (t2tb4 p) (t2tb s))
      (= (Top_List_count qtb1 (t2tb4 p) (t2tb s)) (Top_List_size1 s)))))

;; "Top_List_all_count"
(assert
  (forall ((qta2 ty))
    (forall ((p uni) (s uni))
      (=
        (Top_List_all qta2 p s)
        (= (Top_List_count qta2 p s) (Top_List_size qta2 s))))))

