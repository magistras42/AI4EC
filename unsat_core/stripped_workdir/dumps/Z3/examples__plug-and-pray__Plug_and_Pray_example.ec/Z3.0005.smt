  Int) Bool)

;; "Top_RealExp_is_pow'def"
(assert
  (forall ((b Int) (x Int))
    (=
      (Top_RealExp_is_pow b x)
      (= (Top_Ring_IntID_exp b (Top_RealExp_ilog b x)) x))))

;; "Top_RealExp_is_powP"
(assert
  (forall ((b Int) (x Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x)
        (=
          (Top_RealExp_is_pow b x)
          (exists ((n Int)) (and (<= 0 n) (= x (Top_Ring_IntID_exp b n)))))))))

;; "Top_RealExp_ilog_small"
(assert
  (forall ((b Int) (x Int))
    (=> (< 1 b) (=> (and (< 0 x) (< x b)) (= (Top_RealExp_ilog b x) 0)))))

;; "Top_RealExp_ilog_powK"
(assert
  (forall ((b Int) (n Int))
    (=>
      (< 1 b)
      (=> (<= 0 n) (= (Top_RealExp_ilog b (Top_Ring_IntID_exp b n)) n)))))

;; "Top_RealExp_ilog_mulr"
(assert
  (forall ((b Int) (x Int) (y Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x)
        (=>
          (< 0 y)
          (=>
            (Top_RealExp_is_pow b y)
            (= (Top_RealExp_ilog b (* x y)) (+ (Top_RealExp_ilog b x) 
            (Top_RealExp_ilog
              b
              y)))))))))

;; "Top_RealExp_ilog_mull"
(assert
  (forall ((b Int) (x Int) (y Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x)
        (=>
          (< 0 y)
          (=>
            (Top_RealExp_is_pow b x)
            (= (Top_RealExp_ilog b (* x y)) (+ (Top_RealExp_ilog b x) 
            (Top_RealExp_ilog
              b
              y)))))))))

;; "Top_RealExp_ilog_mono"
(assert
  (forall ((b Int) (x Int) (y Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x)
        (=> (<= x y) (<= (Top_RealExp_ilog b x) (Top_RealExp_ilog b y)))))))

;; "Top_RealExp_ilog_ge0"
(assert
  (forall ((b Int) (x Int))
    (=> (<= 1 b) (=> (<= 1 x) (<= 0 (Top_RealExp_ilog b x))))))

;; "Top_RealExp_ilog_eq"
(assert
  (forall ((b Int) (x Int) (n Int))
    (=>
      (< 1 b)
      (=>
        (< 0 x)
        (=>
          (<= 0 n)
          (=
            (= (Top_RealExp_ilog b x) n)
            (and
              (<= (Top_Ring_IntID_exp b n) x)
              (< x (Top_Ring_IntID_exp b (+ n 1))))))))))

;; "Div_unique"
(assert
  (forall ((x Int) (y Int) (q Int))
    (=>
      (< 0 y)
      (=> (and (<= (* q y) x) (< x (+ (* q y) y))) (= (div x y) q)))))

;; "Div_bound"
(assert
  (forall ((x Int) (y Int))
    (=> (and (<= 0 x) (< 0 y)) (and (<= 0 (div x y)) (<= (div x y) x)))))

;; "Div_inf"
(assert
  (forall ((x Int) (y Int)) (=> (and (<= 0 x) (< x y)) (= (div x y) 0))))

;; "Div_inf_neg"
(assert
  (forall ((x Int) (y Int))
    (=> (and (< 0 x) (<= x y)) (= (div (- x) y) (- 1)))))

;; "Mod_0"
(assert (forall ((y Int)) (=> (not (= y 0)) (= (mod 0 y) 0))))

;; "Div_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div 1 y) 0))))

;; "Div_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (div (- 1) y) (- 1)))))

;; "Mod_1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod 1 y) 1))))

;; "Mod_minus1_left"
(assert (forall ((y Int)) (=> (< 1 y) (= (mod (- 1) y) (- y 1)))))

;; "Div_mult"
(assert
  (forall ((x Int) (y Int) (z Int))
    (! (=> (< 0 x) (= (div (+ (* x y) z) x) (+ y (div z x)))) :pattern ((div (+ (* x y) z) x)) )))

;; "Mod_mult"
(assert
  (forall ((x Int) (y Int) (z Int))
    (! (=> (< 0 x) (= (mod (+ (* x y) z) x) (mod z x))) :pattern ((mod (+ (* x y) z) x)) )))

;; "Top_RealExp_ilog_dvd"
(assert
  (forall ((b Int) (x Int))
    (=>
      (< 0 x)
      (=>
        (< 1 b)
        (=>
          (<= b x)
          (= (Top_RealExp_ilog b x) (+ (Top_RealExp_ilog b (div x b)) 1)))))))

;; "Top_RealExp_ilog_b"
(assert (forall ((b Int)) (=> (< 1 b) (= (Top_RealExp_ilog b b) 1))))

;; "Top_RealExp_ilogP"
(assert
  (forall ((b Int) (x Int))
    (=>
      (< 1 b)
      (=>
        (<= 1 x)
        (and
          (<= (Top_Ring_IntID_exp b (Top_RealExp_ilog b x)) x)
          (< x (Top_Ring_IntID_exp b (+ (Top_RealExp_ilog b x) 1))))))))

