    (=>
      (= E1 (+ E1b E1nb))
      (=>
        (= E1nb E2nb)
        (=> (<= E1b E1bqt) (=> (<= E2nb E2nbqt) (<= E1 (+ E2nbqt E1bqt))))))))

;; "Top_Real_upto_abs"
