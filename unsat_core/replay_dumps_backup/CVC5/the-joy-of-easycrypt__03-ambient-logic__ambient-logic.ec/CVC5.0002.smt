;; "Top_Real_floor"
(declare-fun Top_Real_floor (Real) Int)

;; "Top_Real_from_int_floor_addr"
(assert
  (forall ((n Int) (x1 Real))
    (= (Top_Real_floor (+ x1 (to_real n))) (+ (Top_Real_floor x1) n))))

;; "Top_Real_from_int_floor_addl"
(assert
  (forall ((n Int) (x1 Real))
    (= (Top_Real_floor (+ (to_real n) x1)) (+ n (Top_Real_floor x1)))))

;; "Top_Real_ceil"
(declare-fun Top_Real_ceil (Real) Int)

;; "Top_Real_from_int_ceil_addr"
(assert
  (forall ((n Int) (x1 Real))
    (= (Top_Real_ceil (+ x1 (to_real n))) (+ (Top_Real_ceil x1) n))))

;; "Top_Real_from_int_ceil_addl"
(assert
  (forall ((n Int) (x1 Real))
    (= (Top_Real_ceil (+ (to_real n) x1)) (+ n (Top_Real_ceil x1)))))

;; "Top_Real_floor_gt"
(assert
  (forall ((x1 Real)) (< (+ x1 (- 1.0)) (to_real (Top_Real_floor x1)))))

;; "Top_Real_floorP"
(assert
  (forall ((x1 Real) (n Int))
    (=
      (= (Top_Real_floor x1) n)
      (and (<= (to_real n) x1) (< x1 (+ (to_real n) 1.0))))))

;; "Top_Real_eq_upto"
(assert
  (forall ((E1 Real) (E1b Real) (E1nb Real) (E2 Real) (E2b Real) (E2nb Real))
    (=>
      (= E1 (+ E1b E1nb))
      (=>
        (= E2 (+ E2b E2nb))
        (=> (= E1nb E2nb) (= (+ E1 (- E2)) (+ E1b (- E2b))))))))

;; "Top_Real_divrK"
(assert
  (forall ((u Real) (v Real))
    (=> (not (= v 0.0)) (= u (* (* u (/ 1.0 v)) v)))))

;; "Top_Real_divr0"
(assert (forall ((x1 Real)) (= (* x1 (/ 1.0 0.0)) 0.0)))

;; "Top_Real_ceil_lt"
(assert (forall ((x1 Real)) (< (to_real (Top_Real_ceil x1)) (+ x1 1.0))))

;; "Top_Real_ceil_bound"
(assert
  (forall ((x1 Real))
    (and
      (<= x1 (to_real (Top_Real_ceil x1)))
      (< (to_real (Top_Real_ceil x1)) (+ x1 1.0)))))

;; "Div_unique"
(assert
  (forall ((x1 Int) (y1 Int) (q Int))
    (=>
      (< 0 y1)
      (=> (and (<= (* q y1) x1) (< x1 (+ (* q y1) y1))) (= (div x1 y1) q)))))

;; "Div_bound"
(assert
  (forall ((x1 Int) (y1 Int))
    (=>
      (and (<= 0 x1) (< 0 y1))
      (and (<= 0 (div x1 y1)) (<= (div x1 y1) x1)))))

;; "Div_inf"
(assert
  (forall ((x1 Int) (y1 Int))
    (=> (and (<= 0 x1) (< x1 y1)) (= (div x1 y1) 0))))

;; "Div_inf_neg"
(assert
  (forall ((x1 Int) (y1 Int))
    (=> (and (< 0 x1) (<= x1 y1)) (= (div (- x1) y1) (- 1)))))

;; "Mod_0"
(assert (forall ((y1 Int)) (=> (not (= y1 0)) (= (mod 0 y1) 0))))

;; "Div_1_left"
(assert (forall ((y1 Int)) (=> (< 1 y1) (= (div 1 y1) 0))))

;; "Div_minus1_left"
(assert (forall ((y1 Int)) (=> (< 1 y1) (= (div (- 1) y1) (- 1)))))

;; "Mod_1_left"
(assert (forall ((y1 Int)) (=> (< 1 y1) (= (mod 1 y1) 1))))

;; "Mod_minus1_left"
(assert (forall ((y1 Int)) (=> (< 1 y1) (= (mod (- 1) y1) (- y1 1)))))

;; "Div_mult"
(assert
  (forall ((x1 Int) (y1 Int) (z1 Int))
    (! (=> (< 0 x1) (= (div (+ (* x1 y1) z1) x1) (+ y1 (div z1 x1)))) :pattern ((div (+ (* x1 y1) z1) x1)) )))

;; "Mod_mult"
(assert
  (forall ((x1 Int) (y1 Int) (z1 Int))
    (! (=> (< 0 x1) (= (mod (+ (* x1 y1) z1) x1) (mod z1 x1))) :pattern ((mod (+ (* x1 y1) z1) x1)) )))

;; "Top_IntDiv_%|"
(declare-fun Top_IntDiv_pcbr (Int
  Int) Bool)

;; "Top_IntDiv_%|'def"
(assert (forall ((m Int) (d Int)) (= (Top_IntDiv_pcbr m d) (= (mod d m) 0))))

;; "Top_IntDiv_fromint_div"
(assert
  (forall ((x1 Int) (y1 Int))
    (=>
      (Top_IntDiv_pcbr y1 x1)
      (= (to_real (div x1 y1)) (* (to_real x1) (/ 1.0 (to_real y1)))))))

;; "Top_ln_product"
(assert
  (forall ((x1 Real) (y1 Real))
    (=>
      (< 0.0 x1)
      (=>
        (< 0.0 y1)
        (= (Top_RealExp_ln (* x1 y1)) (+ (Top_RealExp_ln x1) (Top_RealExp_ln
                                                               y1)))))))

;; "Top_exp_product2"
(assert
  (forall ((x1 Real) (a Int) (b Int))
    (=>
      (not (= x1 0.0))
      (= (* (Top_Real_RField_exp x1 a) (Top_Real_RField_exp x1 b)) (Top_Real_RField_exp
                                                                    x1
                                                                    (+ a b))))))

;; Goal "goal"
(assert
  (not (= (* (+ x y) (/ 1.0 z)) (+ (* x (/ 1.0 z)) (* y (/ 1.0 z))))))

(check-sat)
(get-info :reason-unknown)

