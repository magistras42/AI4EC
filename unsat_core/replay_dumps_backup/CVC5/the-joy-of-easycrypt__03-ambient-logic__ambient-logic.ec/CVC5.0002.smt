      (=>
        (= E2 (+ E2b E2nb))
        (=>
          (= E1nb E2nb)
          (<= (Top_Real_bqbr_br (+ E1 (- E2))) (Top_Real_bqbr_br
                                                 (+ E1b (- E2b)))))))))

;; "Top_Real_upto2_abs"
