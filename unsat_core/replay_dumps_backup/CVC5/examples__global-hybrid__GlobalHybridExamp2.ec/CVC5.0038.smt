;; Goal "goal"
(assert
  (not
  (forall ((ethr (tuple2 (tuple10 (tuple3 Top_key Top_key Top_key) Top_exp Top_exp Top_exp Top_ro_in_t Top_exp Top_ro_in_t Top_exp Top_ro_in_t Top_exp) memory)))
    (=>
      (and
        (and
          (and
            (and
              (= (Top_RO_Disting2_sli (proj2_1 ethr)) iqt)
              (and
                (= (Top_Reduct_sli (proj2_1 etm)) iqt)
                (and
                  (= (Top_RO_Disting2_Or_slctr (proj2_1 ethr)) (Top_Reduct_Or_slctr
                                                                 (proj2_1
                                                                   etm)))
                  (and
                    (= (Top_FMap___lb_rb1
                         (Top_FullRO_RO_slm (proj2_1 ethr))
                         Top_A) (Top_Logic_Some q1_R))
                    (and
                      (= (Top_FMap___lb_rb1
                           (Top_FullRO_RO_slm (proj2_1 ethr))
                           Top_B) (Top_Logic_Some q2_R))
                      (and
                        (= (Top_FMap___lb_rb1
                             (Top_FullRO_RO_slm (proj2_1 ethr))
                             Top_C) (Top_Logic_Some q3_R))
                        (and
                          (= (Top_Reduct_slu (proj2_1 etm)) (Top_cf
                                                              Top_g
                                                              q1_R))
                          (and
                            (= (Top_Reduct_slv (proj2_1 etm)) (Top_cf
                                                                Top_g
                                                                q2_R))
                            (= (Top_Reduct_slw (proj2_1 etm)) (Top_cf
                                                                Top_g
                                                                q3_R))))))))))
            (<= (Top_RO_Disting2_Or_slctr (proj2_1 ethr)) Top_m))
          (not
            (< (Top_RO_Disting2_Or_slctr (proj2_1 ethr)) (Top_RO_Disting2_sli
                                                           (proj2_1 ethr)))))
        (= (Top_RO_Disting2_Or_slctr (proj2_1 ethr)) (Top_RO_Disting2_sli
                                                       (proj2_1 ethr))))
      (forall ((r0 Top_exp))
        (=>
          (Top_Distr_support1 Top_dexp r0)
          (forall ((r1 Top_exp))
            (=>
              (Top_Distr_support1 Top_dexp r1)
              (Top_FMap_dom1 (Top_FullRO_RO_slm (proj2_1 ethr)) Top_B)))))))))

