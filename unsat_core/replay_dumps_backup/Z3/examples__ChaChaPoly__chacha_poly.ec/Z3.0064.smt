(declare-sort Top_Logic_option 1)

;; "Top_Logic_option"
(declare-fun Top_Logic_option1 (ty) ty)

;; "Top_Logic_None"
(declare-fun Top_Logic_None (ty) uni)

;; "Top_Logic_None_sort"
(assert
  (forall ((qta1 ty)) (sort (Top_Logic_option1 qta1) (Top_Logic_None qta1))))

;; "Top_Logic_Some"
(declare-fun Top_Logic_Some (ty
  uni) uni)

;; "Top_Logic_Some_sort"
(assert
  (forall ((qta1 ty))
    (forall ((x uni))
      (sort (Top_Logic_option1 qta1) (Top_Logic_Some qta1 x)))))

;; "match_Top_Logic_option"
(declare-fun match_Top_Logic_option (ty
  ty
  uni
  uni
  uni) uni)

;; "match_Top_Logic_option_sort"
(assert
  (forall ((qta1 ty) (a21 ty))
    (forall ((x uni) (x1 uni) (x2 uni))
      (sort a21 (match_Top_Logic_option a21 qta1 x x1 x2)))))

;; "match_Top_Logic_option_Top_Logic_None"
(assert
  (forall ((qta1 ty) (a21 ty))
    (forall ((z uni) (z1 uni))
      (=>
        (sort a21 z)
        (= (match_Top_Logic_option a21 qta1 (Top_Logic_None qta1) z z1) z)))))

;; "match_Top_Logic_option_Top_Logic_Some"
(assert
  (forall ((qta1 ty) (a21 ty))
    (forall ((z uni) (z1 uni) (u uni))
      (=>
        (sort a21 z1)
        (= (match_Top_Logic_option a21 qta1 (Top_Logic_Some qta1 u) z z1) z1)))))

;; "index_Top_Logic_option"
(declare-fun index_Top_Logic_option (ty
  uni) Int)

;; "index_Top_Logic_option_Top_Logic_None"
(assert
  (forall ((qta1 ty))
    (= (index_Top_Logic_option qta1 (Top_Logic_None qta1)) 0)))

;; "index_Top_Logic_option_Top_Logic_Some"
