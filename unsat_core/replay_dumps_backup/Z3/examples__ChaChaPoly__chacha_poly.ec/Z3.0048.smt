;; "Top_Logic_injective"
(declare-fun Top_Logic_injective (ty
  ty
  uni) Bool)

;; "Top_Logic_injective"
(declare-fun Top_Logic_injective1 ((Array (tuple2 Top_Poly_in_poly_in
  Top_Poly_out_poly_out) Top_TPoly_poly)) Bool)

;; "Top_Logic_injective'def"
(assert
  (forall ((f (Array (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out) Top_TPoly_poly)))
    (=
      (Top_Logic_injective1 f)
      (forall ((x1 (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out)) (y (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out)))
        (=> (= (select f x1) (select f y)) (= x1 y))))))

;; "Top_Logic_injective'def"
(assert
  (forall ((qtb ty) (qta ty))
    (forall ((f uni))
      (=
        (Top_Logic_injective qta qtb f)
        (forall ((x1 uni) (y uni))
          (=>
            (sort qta x1)
            (=>
              (sort qta y)
              (=>
                (= (infix_at qtb qta f x1) (infix_at qtb qta f y))
                (= x1 y)))))))))

;; Goal "goal"
(assert
  (not
  (=>
    (Top_Logic_injective1 Top_Step1_2_SplitC2_ofpair_ho)
    (forall ((x1 Top_Poly_in_poly_in) (x2 Top_Poly_out_poly_out))
      (=
        (= x (Tuple2 x1 x2))
        (= (Top_Step1_2_SplitC2_ofpair x) (Top_Step1_2_SplitC2_ofpair
                                            (Tuple2 x1 x2))))))))

(check-sat)

