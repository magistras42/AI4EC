  (forall ((i (Array (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out) Top_TPoly_poly)))
    (! (= (tb2t9 (t2tb9 i)) i) :pattern ((t2tb9 i)) )))

;; "BridgeR"
