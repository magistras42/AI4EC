(assert
  (forall ((f (Array (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out) Top_TPoly_poly)) (g (Array Top_TPoly_poly (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out))))
    (=
      (Top_Logic_cancel
        (tuple21 Top_Poly_in_poly_in1 Top_Poly_out_poly_out1)
        Top_TPoly_poly1
        (t2tb9 f)
        (t2tb8 g))
      (forall ((x (tuple2 Top_Poly_in_poly_in Top_Poly_out_poly_out)))
        (= (tb2t7
             (infix_at
               (tuple21 Top_Poly_in_poly_in1 Top_Poly_out_poly_out1)
