  Top_DH_G_group
  Top_DH_G_group)))

;; "Top_PKE__qD"
(declare-fun Top_PKE__qD () Int)

;; "Top_G1_/cstar"
(declare-fun Top_G1_slcstar (memory) (Top_Logic_option (tuple4 Top_DH_G_group
  Top_DH_G_group
  Top_DH_G_group
  Top_DH_G_group)))

;; Goal "goal"
(assert
  (not
  (forall ((ethr (tuple2 (tuple7 (tuple4 Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group) (Top_Logic_option Top_DH_G_group) Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_G_group Top_DH_GP_ZModE_exp) memory)))
    (=>
      (and
        (<= (Top_List_size1 (Top_G3_slcilog (proj2_1 ethr))) (Top_List_size1
                                                               (Top_G1_sllog
                                                                 (proj2_1
                                                                   ethr))))
        (<= (Top_List_size1 (Top_G1_sllog (proj2_1 ethr))) Top_PKE__qD))
      (ite (and
             (< (Top_List_size1 (Top_G1_sllog (proj2_1 ethr))) Top_PKE__qD)
             (not
               (= (Top_Logic_Some (proj7_0 (proj2_0 ethr))) (Top_G1_slcstar
                                                              (proj2_1 ethr)))))
        (and
          (<= (Top_List_size1
                (ite (= (Top_G1_slcstar (proj2_1 ethr)) (as Top_Logic_None (Top_Logic_option (tuple4 Top_DH_G_group
                                                        Top_DH_G_group
                                                        Top_DH_G_group
                                                        Top_DH_G_group))))
                  (Top_List_clcl
                    (proj7_0 (proj2_0 ethr))
                    (Top_G3_slcilog (proj2_1 ethr)))
                  (Top_G3_slcilog (proj2_1 ethr)))) (+ 1 (Top_List_size1
                                                           (Top_G1_sllog
                                                             (proj2_1 ethr)))))
          (<= (+ 1 (Top_List_size1 (Top_G1_sllog (proj2_1 ethr)))) Top_PKE__qD))
        (and
          (<= (Top_List_size1 (Top_G3_slcilog (proj2_1 ethr))) (Top_List_size1
                                                                 (Top_G1_sllog
                                                                   (proj2_1
                                                                    ethr))))
          (<= (Top_List_size1 (Top_G1_sllog (proj2_1 ethr))) Top_PKE__qD)))))))

(check-sat)

